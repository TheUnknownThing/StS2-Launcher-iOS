<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>sts2</AssemblyName>
    <RootNamespace>MegaCrit.Sts2</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- The game uses reflection-based JSON serialization without source-generated contexts. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <WovenAssembly>$(MSBuildProjectDirectory)/prebuilt/sts2.dll</WovenAssembly>
    <PrebuiltDir>$(MSBuildProjectDirectory)/prebuilt</PrebuiltDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(PrebuiltDir)/deps/*.dll">
      <Private>true</Private>
    </Reference>
    <!-- Godot roots the main assembly; preserve the separately compiled mobile hooks too. -->
    <TrimmerRootAssembly Include="STS2MobileIos" />
  </ItemGroup>

  <!-- Replace the empty compiler output before NativeAOT reads its managed input.
       See docs/architecture.md for why the game assembly is injected here. -->
  <Target Name="InjectWovenAssembly" AfterTargets="CoreCompile" BeforeTargets="IlcCompile">
    <Error Condition="!Exists('$(WovenAssembly)')"
           Text="Missing woven assembly: $(WovenAssembly). Run python3 scripts/ios/build.py build." />
    <Message Importance="high" Text="Injecting woven assembly into $(IntermediateOutputPath)sts2.dll" />
    <Copy SourceFiles="$(WovenAssembly)"
          DestinationFiles="$(IntermediateOutputPath)sts2.dll"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(WovenAssembly)"
          DestinationFiles="$(TargetPath)"
          OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
